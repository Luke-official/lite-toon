{
  "name": "@lite-toon/bridge",
  "version": "0.1.0",
  "description": "Public SDK entry point for Lite-Toon — connect AI agents to your web app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luke-official/lite-toon.git",
    "directory": "packages/bridge"
  },
  "bugs": "https://github.com/Luke-official/lite-toon/issues",
  "homepage": "https://github.com/Luke-official/lite-toon#readme",
  "keywords": ["lite-toon", "ai-agents", "mcp", "oauth", "toon", "sdk"],
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toon": {
      "types": "./dist/toon.d.ts",
      "import": "./dist/toon.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@lite-toon/adapter-next": "*",
    "@lite-toon/auth": "*",
    "@lite-toon/core": "*",
    "@lite-toon/toon": "*",
    "@lite-toon/adapter-hono": "*",
    "@lite-toon/adapter-express": "*",
    "@lite-toon/adapter-fastify": "*",
    "@lite-toon/adapter-stdio": "*"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
